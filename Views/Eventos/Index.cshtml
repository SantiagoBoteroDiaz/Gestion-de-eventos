<link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">

<!-- Iconos -->
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<!-- 🏆 Hero -->
<div class="hero">
    <div class="container center-align">
        <h1>Vive el deporte al máximo</h1>
        <p class="flow-text">Encuentra, participa y disfruta los mejores eventos deportivos</p>
        <br>
        <a asp-action="ViewEvents" asp-controller="Eventos" class="btn-large waves-effect waves-light red">
            Ver Eventos
            <i class="material-icons right">arrow_forward</i>
        </a>
        <br>
        <br>
        <a asp-controller="Eventos" asp-action="Dashboard">Ver dashboard</a>
        </div>
</div>
    
    <div class="section container">
        <div class="row">

            <div class="col s12 m4 center-align">
                <i class="large material-icons blue-text">sports_soccer</i>
                <h5>Variedad de Deportes</h5>
                <p>Fútbol, baloncesto, running y muchos más eventos disponibles.</p>
            </div>

            <div class="col s12 m4 center-align">
                <i class="large material-icons green-text">event</i>
                <h5>Eventos en Tiempo Real</h5>
                <p>Mantente actualizado con los próximos eventos cerca de ti.</p>
            </div>

            <div class="col s12 m4 center-align">
                <i class="large material-icons red-text">groups</i>
                <h5>Comunidad</h5>
                <p>Conecta con personas que comparten tu pasión por el deporte.</p>
            </div>

        </div>
        </div>