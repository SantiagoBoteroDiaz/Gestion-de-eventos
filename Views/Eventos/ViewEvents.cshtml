@model IEnumerable<GentionDeDeportes.Models.Eventos>

<link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>

<body class="darken-4">

<div class="container">

    <div class="section center-align">
        <h2 class="bold">Eventos Deportivos</h2>
        <p class="flow-text">
            Descubre torneos, carreras y competencias disponibles
        </p>
        <a asp-controller="Eventos" asp-action="Index">Volver</a>
    </div>

    <div class="row">

        @foreach (var evento in Model)
        {
            <div class="col-6 s12 m6 l6">
                <div class="card hoverable z-depth-3">

                    <div class="card-content">
                        <span class="card-title blue-text text-darken-2">
                            @evento.Name
                        </span>

                        <p class="grey-text text-darken-1">
                            @evento.Description
                        </p>

                        <br>
                        
                        <p class="teal-text text-darken-2">
                              @evento.Date
                        </p>
                    </div>

                </div>
            </div>
        }

    </div>

</div>

</body>