@model IEnumerable<GentionDeDeportes.Models.Eventos>

<style>
    :root {
        --sport-dark: #1A1A2E;
        --sport-red: #E8341A;
        --sport-amber: #F5A623;
    }

    .eventos-header {
        text-align: center;
        padding: 2.5rem 0 2rem;
    }

    .eventos-header h2 {
        font-size: 2rem;
        font-weight: 800;
        color: var(--sport-dark);
        margin-bottom: 0.4rem;
        letter-spacing: -0.5px;
    }

    .eventos-header p {
        color: #6B7280;
        font-size: 1rem;
        margin-bottom: 1.5rem;
    }

    .btn-volver {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--sport-dark);
        color: white !important;
        font-weight: 600;
        font-size: 0.875rem;
        padding: 9px 22px;
        border-radius: 24px;
        text-decoration: none;
        transition: background 0.2s;
    }

    .btn-volver:hover {
        background: #2d2d4e;
        color: white !important;
    }

    /* Card */
    .evento-card {
        border: 0.5px solid #E5E7EB !important;
        border-radius: 14px !important;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .evento-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0,0,0,0.10) !important;
    }

    .evento-card-accent {
        height: 4px;
        background: linear-gradient(90deg, var(--sport-red), var(--sport-amber));
    }

    .evento-card .card-body {
        padding: 1.25rem;
        flex: 1;
    }

    .sport-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #FEF3E2;
        color: #92400E;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 10px;
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .evento-card .card-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--sport-dark);
        margin-bottom: 0.5rem;
        line-height: 1.35;
    }

    .evento-card .card-text {
        font-size: 0.875rem;
        color: #6B7280;
        line-height: 1.6;
        min-height: 60px;
    }

    .evento-card-footer {
        padding: 12px 1.25rem;
        background: #FAFAFA;
        border-top: 0.5px solid #F3F4F6;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .fecha-block {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fecha-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #EFF6FF;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .fecha-dia {
        font-size: 0.8125rem;
        font-weight: 700;
        color: var(--sport-dark);
        line-height: 1.2;
    }

    .fecha-hora {
        font-size: 0.7rem;
        color: #9CA3AF;
    }

    .badge-estado {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 10px;
    }

    .badge-proximo {
        background: #ECFDF5;
        color: #065F46;
    }
</style>

<div class="container py-2">

    <div class="eventos-header">
        <div style="font-size: 2.5rem; margin-bottom: 8px;"></div>
        <h2>Eventos Deportivos</h2>
        <p>Encuentra los próximos eventos disponibles</p>
        <a asp-controller="Eventos" asp-action="Index" class="btn-volver">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="row g-4">
        @foreach (var evento in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card evento-card shadow-sm">
                    <div class="evento-card-accent"></div>
                    <div class="card-body">
                        <span class="sport-badge">⚽ Deporte</span>
                        <h5 class="card-title">@evento.Name</h5>
                        <p class="card-text">@evento.Description</p>
                    </div>
                    <div class="evento-card-footer">
                        <div class="fecha-block">
                            <div class="fecha-icon">📅</div>
                            <div>
                                <div class="fecha-dia">@evento.Date?.ToString("dd/MM/yyyy")</div>
                                <div class="fecha-hora">@evento.Date?.ToString("HH:mm") hrs</div>
                            </div>
                        </div>
                        <span class="badge-estado badge-proximo">Próximo</span>
                    </div>
                </div>
            </div>
        }
    </div>

</div>